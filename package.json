{
  "name": "@yuneco/canvas-text-styled",
  "author": "yuneco, https://twitter.com/yuneco",
  "license": "MIT",
  "version": "0.1.12",
  "keywords": [
    "canvas",
    "text",
    "styled",
    "multiline"
  ],
  "description": "Draw styled & multiline text on canvas. Supports css compatible line break and vertical vertical writing(vertical-rl).",
  "type": "module",
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/yuneco/canvas-draw-styled-text.git"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "require": "./dist/index.umd.cjs",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "pnpm --filter ./sample dev",
    "build-docs": "pnpm --filter ./sample build && tsc && tsc -p sample",
    "build": "vite build && tsc",
    "preview": "pnpm --filter ./sample preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:browser": "vitest --browser",
    "test:chrome": "node scripts/chrome-for-testing.mjs && vitest --run --config vitest.chrome.config.ts",
    "release:dry": "pnpm test:browser --run && pnpm build && pnpm publish --dry-run --no-git-checks",
    "release": "pnpm test:browser --run && pnpm build && pnpm publish"
  },
  "devDependencies": {
    "@puppeteer/browsers": "^3.2.3",
    "@types/node": "^26.6.3",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "playwright": "^1.58.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "css-line-break": "^2.1.0"
  },
  "packageManager": "pnpm@9.15.9+sha512.68046141893c66fad01c079231128e9afb89ef87e2691d69e4d40eee228988295fd4682181bae55b58418c3a253bde65a505ec7c5f9403ece5cc3cd37dcf2531",
  "engines": {
    "pnpm": ">=9.0.0"
  }
}
